# Исключаем локальную папку инициализации (в ней хранятся провайдеры и модули)
.terraform/

# Исключаем файлы состояния (State), так как они содержат секреты и генерируются автоматически
*.tfstate
*.tfstate.*

# Исключаем файлы блокировки состояния (Lock-файлы), если они создаются локально
*.tfstate.lock.info

# Исключаем файлы с вашими локальными переменными (где вы храните пароли и кастомные настройки)
*.tfvars
*.tfvars.json

# Исключаем кастомные файлы локальных плагинов (редко используются, но полезно)
*.tfrc
terraform.rc

# Исключаем файлы планов (Plan), которые вы сохраняете при 'terraform plan -out=...'
*.tfplan

# --- Особое исключение (Оставляем файлы блокировки провайдеров) ---
# .terraform.lock.hcl ОБЯЗАТЕЛЬНО должен быть в Git.
# Следующие строки гарантируют, что он не будет случайно проигнорирован.
!.terraform.lock.hcl
